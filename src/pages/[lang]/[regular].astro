---
import Base from '@/layouts/Base.astro';
import AuthorBox from '@/layouts/components/AuthorBox.astro';
import { getSinglePage } from '@/lib/contentParser.astro';
import PageHeader from '@/partials/PageHeader.astro';
import { render } from 'astro:content';
import mainConfig from '@/config/main-config.json';

export async function getStaticPaths() {
  const paths = [];

  for (const lang of mainConfig.settings.languages) {
    const pages = await getSinglePage('pages', lang);

    for (const page of pages) {
      const regular = page.id.replace(`${lang}/`, '').replace(/\.mdx?$/, '');

      paths.push({
        params: {
          lang,
          regular,
        },
        props: {
          page,
        },
      });
    }
  }

  return paths;
}

const { page } = Astro.props;
const { lang } = Astro.params;

const { title, meta_title, description, image, justify, showAuthor } = page.data;
const { Content } = await render(page);
---

<Base title={title} meta_title={meta_title} description={description} image={image}>
  <PageHeader title={title} />
  <section class="py-14 lg:py-20">
    <div class="container" class:list={justify ? 'text-left md:text-justify' : ''}>
      <div class="row justify-center rounded-2xl border border-border bg-white/[0.03] p-8 lg:p-12">
        <div class="lg:col-10">
          <div class="content">
            <Content />
          </div>
          {showAuthor && <AuthorBox lang={lang} className="mt-8 mb-6" />}
        </div>
      </div>
    </div>
  </section>
</Base>
