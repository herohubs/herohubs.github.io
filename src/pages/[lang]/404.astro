---
import Base from '@/layouts/Base.astro';
import mainConfig from '@/config/main-config.json';
import { loadLocalizedConfig } from '@/lib/utils/lang';

const { lang } = Astro.params;
const i18n = await loadLocalizedConfig(lang, 'i18n');

export async function getStaticPaths() {
  const languages = mainConfig.settings.languages;
  return languages.map((lang) => ({
    params: { lang },
  }));
}
---

<Base title={i18n.not_found_title} lang={lang}>
  <section class="section-sm text-center">
    <div class="container">
      <div class="row justify-center">
        <div class="sm:col-10 md:col-8 lg:col-6">
          <span class="text-[8rem] block font-bold text-text-dark">404</span>
          <h1 class="h2 mb-4">{i18n.not_found_title}</h1>
          <div class="content">
            <p>{i18n.not_found_text}</p>
          </div>
          <a href={`/${lang}`} class="btn btn-primary mt-8">
            {i18n.back_home}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
