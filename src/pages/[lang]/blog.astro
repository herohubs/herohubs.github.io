---
import Base from '@/layouts/Base.astro';
import Post from '@/components/Post.astro';
import Pagination from '@/components/Pagination.astro';
import PageHeader from '@/partials/PageHeader.astro';
import { getSinglePage } from '@/lib/contentParser.astro';
import { sortByDate } from '@/lib/utils/sortFunctions';
import mainConfig from '@/config/main-config.json';
import { loadLocalizedConfig } from '@/lib/utils/lang';

const { lang } = Astro.params;
const config: any = await loadLocalizedConfig(lang, 'config');

export async function getStaticPaths() {
  const languages = mainConfig.settings.languages;
  return languages.map((lang) => ({
    params: { lang },
  }));
}

const posts = (await getSinglePage('posts', lang)).filter((p) => p.id.startsWith(`${lang}/`));

const postsWithCleanId = posts.map((p) => ({
  ...p,
  cleanId: p.id.replace(`${lang}/`, ''),
}));

const { pagination } = mainConfig.settings;
const sortPostByDate = sortByDate(postsWithCleanId);

const paginatedPosts = sortPostByDate.slice(0, pagination);

const totalPages = Math.ceil(postsWithCleanId.length / pagination);
---

<Base meta_title={config.blog.title} description={config.blog.meta_description} lang={lang}>
  <PageHeader title={config.blog.title} text={config.blog.meta_description} />
  <section class="py-14 lg:py-20">
    <div class="container">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {paginatedPosts.map((post) => <Post post={post} lang={lang} id={post.cleanId} />)}
      </div>
      <div class="mt-12">
        <Pagination totalPages={totalPages} currentPage={1} lang={lang} />
      </div>
    </div>
  </section>
</Base>
