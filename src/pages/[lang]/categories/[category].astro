---
import Post from '@/components/Post.astro';
import Base from '@/layouts/Base.astro';
import mainConfig from '@/config/main-config.json';
import { getSinglePage } from '@/lib/contentParser.astro';
import { getTaxonomy } from '@/lib/taxonomyParser.astro';
import taxonomyFilter from '@/lib/utils/taxonomyFilter';
import PageHeader from '@/partials/PageHeader.astro';
import { sortByDate } from '@/lib/utils/sortFunctions';
import { loadLocalizedConfig } from '@/lib/utils/lang';

const { lang, category } = Astro.params;
const config: any = await loadLocalizedConfig(lang, 'config');

export async function getStaticPaths() {
  const paths = [];

  for (const lang of mainConfig.settings.languages) {
    const categories = await getTaxonomy('posts', 'categories', lang);

    for (const category of categories) {
      paths.push({
        params: {
          lang,
          category,
        },
      });
    }
  }

  return paths;
}

const posts = (await getSinglePage('posts', lang)).filter((p) => p.id.startsWith(`${lang}/`));
const filterByCategories = taxonomyFilter(posts, 'categories', category!);
const categoryLabel =
  posts.flatMap((post) => post.data.categories).find((name: string) => name.toLowerCase() === category) ?? category;
---

<Base meta_title={categoryLabel} lang={lang}>
  <PageHeader title={categoryLabel} eyebrow={config.blog.title} />
  <section class="py-14 lg:py-20">
    <div class="container">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sortByDate(filterByCategories).map((post) => <Post post={post} lang={lang} />)}
      </div>
    </div>
  </section>
</Base>
