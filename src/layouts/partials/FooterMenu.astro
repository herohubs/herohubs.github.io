---
import type { INavigationLink } from '@/interfaces';
import { loadLocalizedConfig } from '@/lib/utils/lang';
import { translatePath } from '@/lib/utils/translatePath';

const { menu, showLangSwitcher, lang } = Astro.props as {
  menu: INavigationLink[];
  showLangSwitcher?: boolean;
  lang?: string;
};
const currentPath = Astro.url.pathname;
// only the link to the other language is rendered, so only that one is computed
const englishUrl = lang !== 'en' ? await translatePath(currentPath, 'en') : undefined;
const italianUrl = lang !== 'it' ? await translatePath(currentPath, 'it') : undefined;

const i18n: any = await loadLocalizedConfig(lang, 'i18n');
---

<div>
  <ul class="space-y-2 text-center">
    {
      menu.map((m) => (
        <li>
          <a href={m.url} class="hover:text-primary-light transition-colors text-sm">
            {m.name}
          </a>
        </li>
      ))
    }
  </ul>
  {
    showLangSwitcher && (
      <div class="mt-4 text-center">
        <span class="text-sm text-gray-400 mr-2">{i18n.langSwitcher.label}:</span>
        {lang !== 'en' && (
          <a href={englishUrl} class="text-primary-light underline mx-1">
            {i18n.langSwitcher.en}
          </a>
        )}
        {lang !== 'it' && (
          <a href={italianUrl} class="text-primary-light underline mx-1">
            {i18n.langSwitcher.it}
          </a>
        )}
      </div>
    )
  }
</div>
