---
import { humanize } from '@/lib/utils/textConverter';
const { title = '', eyebrow = '', text = '' }: { title?: string; eyebrow?: string; text?: string } = Astro.props;
---

<section class="border-b border-border/60 py-14 lg:py-20">
  <div class="container text-center">
    {eyebrow && <p class="text-xs font-semibold uppercase tracking-widest text-primary">{eyebrow}</p>}
    <h1 set:text={humanize(title)} class="mt-3 text-4xl font-bold text-text-dark lg:text-5xl" />
    {text && <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-text">{text}</p>}
  </div>
</section>
